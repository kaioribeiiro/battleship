{
  "name": "battleship",
  "version": "1.0.0",
  "description": "Real-time multiplayer Battleship tactical game built with Node.js, Express 5, Socket.IO 4, Sequelize (SQLite), and React 18.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "coverage": "jest --coverage --runInBand",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:test": "npm --prefix frontend run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaioribeiiro/battleship.git"
  },
  "keywords": [
    "battleship",
    "batalha-naval",
    "multiplayer",
    "socket.io",
    "websockets",
    "nodejs",
    "express",
    "sequelize",
    "sqlite",
    "react",
    "vite"
  ],
  "author": "Kaio Ribeiro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kaioribeiiro/battleship/issues"
  },
  "homepage": "https://battleship-ogod.onrender.com/",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ]
  }
}
