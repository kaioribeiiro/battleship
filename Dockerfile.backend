# Stage de dependências: compila os módulos nativos (sqlite3, bcrypt) em musl.
FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci --omit=dev

# Stage de runtime: imagem enxuta apenas com o necessário para rodar o backend.
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY server.js ./
COPY src/ ./src
RUN mkdir -p /app/data
EXPOSE 3000
CMD ["node", "server.js"]
